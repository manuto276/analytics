# analytics — environment template
#
# Packaged as `.env.example` at the root of a release tarball. On a server the
# real file lives in <deploy_root>/shared/.env (mode 0600) and is symlinked into
# every release; with Docker it is the `env_file` of compose.prod.yml.
# Generate the secrets with:  bin/analytics secrets:generate
#
# Every variable below is read by services/api/src/Kernel/Settings.php.

# --- Application -------------------------------------------------------------
# prod | dev | test
APP_ENV=prod
# Public URL of the service, no trailing slash. Drives CORS, cookie flags,
# the tracker snippet and the dashboard origin check.
APP_URL=https://stats.example.net
# warning (prod default) | notice | info | debug
LOG_LEVEL=warning
# Shown in the dashboard footer and in the tracker header (AGPL source offer).
SOURCE_URL=https://github.com/manuto276/analytics

# --- Secrets (never commit real values) --------------------------------------
# Base64 of 32 random bytes; HMAC key for salts, tokens and customer references.
APP_SECRET=
# Key ring for encrypted columns: "id:base64key[,id:base64key]"; the last entry
# is the active key. Ids match [a-z0-9]{1,8}.
APP_ENCRYPTION_KEYS=
# Optional token for POST /_ops/opcache-reset (localhost only). Empty = disabled.
OPS_TOKEN=

# --- Database ----------------------------------------------------------------
# Either one DSN…
DATABASE_URL=mysql://analytics:change-me@127.0.0.1:3306/analytics?serverVersion=8.4
# …or the individual parts (used only when DATABASE_URL is empty).
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_NAME=analytics
#DB_USER=analytics
#DB_PASSWORD=change-me
# MySQL partitioning for the hot tables; false on hosts that forbid it.
DB_PARTITIONING=true

# --- Optional Redis ----------------------------------------------------------
# Enables the Redis cache, rate-limit storage, locks and the queue sink.
# Empty = database/file based (fine for small installations).
#REDIS_DSN=redis://redis:6379/0

# --- Ingestion ---------------------------------------------------------------
# sync  = write during the request (default)
# queue = push to Redis, `bin/analytics queue:work` writes (needs REDIS_DSN)
INGEST_MODE=sync
# Reverse proxies whose X-Forwarded-For may be trusted (comma separated CIDRs).
# The client IP is shortened immediately after it is resolved.
TRUSTED_PROXIES=
# Raw data retention in months (rollups are kept).
RETENTION_MONTHS=13

# --- Paths (absolute, or relative to the release root) -----------------------
# On a tarball deploy these point into <deploy_root>/shared.
#STORAGE_DIR=/home/site/htdocs/stats.example.net/shared/var/storage
#LOG_DIR=/home/site/htdocs/stats.example.net/shared/var/log
#CACHE_DIR=/home/site/htdocs/stats.example.net/current/var/cache
# DB-IP Lite Country database (CC BY 4.0), refreshed by `bin/analytics geo:update`.
#GEO_DB_PATH=/home/site/htdocs/stats.example.net/shared/var/storage/geo/dbip-country-lite.mmdb
# Override the download URL of geo:update (defaults to the DB-IP monthly build).
#GEO_DB_URL=

# --- Mail (optional: invitations and password resets) ------------------------
# Without a DSN, invitations are copyable links and passwords are set with
# `bin/analytics user:set-password`.
#MAILER_DSN=smtp://localhost:1025
MAIL_FROM=analytics@example.net

# --- Test only ---------------------------------------------------------------
# Honoured when APP_ENV=test: freezes the clock (ISO-8601).
#APP_TEST_CLOCK=2026-09-17T12:00:00Z
