msgstr "Un link per cambiare la scelta"

#: build/admin.js:5
msgid "Visitors must be able to change their mind about cookies. Any of these opens the banner again:"
msgstr "Chi visita il sito deve poter cambiare idea sui cookie. Ognuno di questi riapre il banner:"

#: build/admin.js:5
msgid "Block"
msgstr "Blocco"

#: build/admin.js:5
msgid "“Consent settings link”, in the editor or a footer template."
msgstr "«Link alle impostazioni del consenso», nell’editor o in un template del piè di pagina."

#: build/admin.js:5
msgid "Shortcode"
msgstr "Shortcode"

#: build/admin.js:5
