#. Plugin Name of the plugin
#: analytics-connector.php
#: includes/admin-app.php:39
#: includes/admin-app.php:122
msgid "Analytics"
msgstr "Analytics"

#. Plugin URI of the plugin
#: analytics-connector.php
msgid "https://github.com/manuto276/analytics"
msgstr ""

#. Description of the plugin
#: analytics-connector.php
msgid "The site's visits, sources and conversions, measured by your own analytics service — the tracker and its consent banner on every page, and a dashboard in WordPress."
msgstr "Le visite, le provenienze e le conversioni del sito, misurate dal tuo servizio di analytics: il tracker e il suo banner dei consensi su ogni pagina, e una dashboard in WordPress."

#. Author of the plugin
#: analytics-connector.php
msgid "Analytics contributors"
msgstr ""

