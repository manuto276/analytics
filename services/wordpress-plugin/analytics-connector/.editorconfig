# WordPress coding standards use tabs for PHP, JavaScript and JSON.
[*.{php,js,json}]
indent_style = tab
indent_size = 4

[tests/composer.json]
indent_style = space
indent_size = 4

[*.{txt,md,yml,yaml,sh,xml,dist}]
indent_style = space
indent_size = 2

[tests/**.php]
indent_style = space
indent_size = 4
