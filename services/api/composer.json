{
    "name": "analytics/api",
    "description": "Self-hosted, privacy-first web analytics service (API, ingestion, console)",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "doctrine/dbal": "^4",
        "doctrine/migrations": "^3",
        "doctrine/orm": "^3",
        "jaybizzle/crawler-detect": "^1.4",
        "matomo/device-detector": "^6.5",
        "maxmind-db/reader": "^1.14",
        "monolog/monolog": "^3",
        "php-di/php-di": "^7",
        "php-di/slim-bridge": "^3.4",
        "predis/predis": "^3.6",
        "psr/clock": "^1.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "spomky-labs/otphp": "^11.5",
        "symfony/cache": "^8",
        "symfony/clock": "^8",
        "symfony/console": "^8",
        "symfony/dotenv": "^8",
        "symfony/lock": "^8",
        "symfony/mailer": "^8",
        "symfony/rate-limiter": "^8",
        "symfony/uid": "^8"
    },
    "autoload": {
        "psr-4": { "Analytics\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Analytics\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.4.1" },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "brianium/paratest": "^7.24",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/openapi-psr7-validator": "^0.24.0",
        "opis/json-schema": "^2.6",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest"
    }
}
